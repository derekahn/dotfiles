# Load zsh configs
# ---------------
for config in $HOME/.dotfiles/zsh/*.zsh; do
	source "$config"
done

# zsh profiling - run PROFILE_ZSH=1 zsh to enable (cmd: zprof)
# ---------------
[[ -n "$PROFILE_ZSH" ]] && zmodload zsh/zprof

# Load zsh theme
# ---------------
eval "$(starship init zsh)"
export STARSHIP_CONFIG=$HOME/.config/starship/config.toml

# Setup fzf (fuzzy finder: vim, command history)
# ---------------
if [[ $(uname -m) == "arm64" ]]; then
	FZF_PATH="/opt/homebrew/opt/fzf"
else
	FZF_PATH="/usr/local/opt/fzf"
fi

if [[ -d "$FZF_PATH/bin" && ! "$PATH" == *"$FZF_PATH/bin"* ]]; then
	export PATH="$PATH:$FZF_PATH/bin"
fi

export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git" --glob "!node_modules" --glob "!.venv"'
[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh

# Nvim
# ---------------
alias vim='nvim'
export EDITOR='nvim'

alias tmux="TERM=screen-256color-bce tmux"

# https://github.com/nvim-neorg/tree-sitter-norg/issues/7#issuecomment-1291508121
export CC=gcc-12

# Magical shell history
# ---------------
eval "$(atuin init zsh)"

### Added by Zinit's installer
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing %F{33}ZDHARMA-CONTINUUM%F{220} Initiative Plugin Manager (%F{33}zdharma-continuum/zinit%F{220})…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Installation successful.%f%b" || \
        print -P "%F{160} The clone has failed.%f%b"
fi

source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# Load a few important annexes, without Turbo
# (this is currently required for annexes)
zinit light-mode for \
    zdharma-continuum/zinit-annex-as-monitor \
    zdharma-continuum/zinit-annex-bin-gem-node \
    zdharma-continuum/zinit-annex-patch-dl \
    zdharma-continuum/zinit-annex-rust

zinit light zdharma-continuum/fast-syntax-highlighting
zinit light zsh-users/zsh-autosuggestions
bindkey '^ ' autosuggest-accept
export PATH="/opt/homebrew/sbin:$PATH"
